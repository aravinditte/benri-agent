# Benri Agent environment (SPEC §18). Copy to .env for local use.
BENRI_ENV=development
DEMO_MODE=1
MOCK_LLM=1
# Store: sqlite = locally verified path; postgres = Compose path (per-role URLs below)
BENRI_STORE=sqlite
BENRI_DB_PATH=./data/benri.sqlite
API_PORT=8080
# ModelRail (live mode only; leave base URL empty for the deterministic mock)
MODELRAIL_BASE_URL=
MODELRAIL_API_KEY=
MODELRAIL_CHAT_MODEL=default
# Kairo / OpenTelemetry (optional; export failure never fails a run)
OTEL_EXPORTER_OTLP_ENDPOINT=
KAIRO_TRACE_UI_BASE_URL=
OTEL_SERVICE_NAME=benri
# Kagome dictionary: ipa | uni (benchmark in evals/reports/latest.md)
BENRI_KAGOME_DICT=ipa
BENRI_ROOT_DIR=.
# MCP server binaries (used when BENRI_USE_MCP=1)
BENRI_USE_MCP=0
BENRI_MCP_KB_BIN=./bin/mcp-kb
BENRI_MCP_CRM_BIN=./bin/mcp-crm
BENRI_MCP_TICKET_BIN=./bin/mcp-ticket
# PostgreSQL per-role URLs (BENRI_STORE=postgres; Compose deployments)
BENRI_API_DATABASE_URL=
BENRI_AGENT_DATABASE_URL=
BENRI_EXECUTOR_DATABASE_URL=
BENRI_KB_MCP_DATABASE_URL=
BENRI_CRM_MCP_DATABASE_URL=
BENRI_TICKET_MCP_DATABASE_URL=
BENRI_MIGRATE_DATABASE_URL=
