{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022"], "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true, "resolveJsonModule": true,
    "types": ["node"], "noEmit": true
  },
  "include": ["packages/*/src/**/*.ts", "apps/api/src/**/*.ts", "apps/agent-worker/src/**/*.ts", "apps/executor-worker/src/**/*.ts", "evals/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["**/node_modules/**", "apps/web"]
}
